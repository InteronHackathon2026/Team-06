# Firebase — from Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# WebSocket URL for the Arduino bridge server (see src/hooks/useSensorStream.js)
VITE_SENSOR_WS_URL=ws://localhost:5000/stream

# Your own backend endpoint that holds the Gemini API key server-side
# (see src/utils/aiAnalysis.js) — never put the Gemini key in frontend env vars
VITE_ANALYSIS_API_URL=/api/analyze
